{
  "name": "vq-school-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n shell,academic,learning,public \"npm run dev -w @vq/shell\" \"npm run dev -w @vq/academic\" \"npm run dev -w @vq/learning\" \"npm run dev -w @vq/public\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.5",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.7",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "24.10.1",
    "@playwright/test": "1.58.2",
    "concurrently": "9.2.1"
  }
}
