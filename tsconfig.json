{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@vq/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@vq/ui": [
        "./packages/ui/src/index.tsx"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "*.ts"
  ]
}
